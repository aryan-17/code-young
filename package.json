{
  "name": "code-young",
  "private": true,
  "workspaces": [
    "shared",
    "server",
    "client"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=server & npm run dev --workspace=client & wait",
    "build": "npm run build --workspaces",
    "test": "npm run test --workspaces --if-present",
    "test:server": "npm test --workspace=server",
    "test:client": "npm test --workspace=client",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "seed": "npm run seed --workspace=server",
    "seed:scenarios": "npm run seed:scenarios --workspace=server"
  }
}
